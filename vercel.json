{
  "crons": [
    {
      "path": "/api/cron/run-delete-sessions",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/run-active-sessions",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/run-currency-update",
      "schedule": "0 0 * * *"
    }
  ],
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "build": {
    "env": {
      "NODE_VERSION": "18.x"
    }
  }
}